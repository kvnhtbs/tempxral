# Copia este archivo a ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" real a GitHub.

# Cadena de conexión de PostgreSQL que te da tu proveedor (Render, Railway, etc.)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_basedatos

# Pon "false" solo si tu proveedor de Postgres no requiere SSL (poco común en producción)
DATABASE_SSL=true

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# Puerto en el que escucha el servidor (Render lo asigna solo, no lo toques ahí)
PORT=3000

# "production" activa cookies "secure" (requiere HTTPS, que Render ya te da)
NODE_ENV=production

# Deja vacío/comentado si frontend y backend van en el mismo dominio (recomendado, es como está montado este proyecto)
# FRONTEND_ORIGIN=https://tempxral.com
